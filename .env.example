# NexClaim environment template. Copy to .env and set values locally.
# Never commit .env or real credentials.

# Required: generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_KEY_AT_LEAST_32_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gmail SMTP (optional for local development; use a Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=NexClaim

# Database
DATABASE_URL=sqlite:///./database.db

# Application
APP_NAME=NexClaim
APP_VERSION=1.0.0
DEBUG=false
# Comma-separated origins. Add only trusted front-end origins.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# File Upload
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,tiff

# OTP
OTP_EXPIRE_MINUTES=10

# Optional initial seed accounts. Set unique credentials before first startup
# if you need these accounts. If blank, seed accounts are not created.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
REVIEWER_NAME=Claims Reviewer
